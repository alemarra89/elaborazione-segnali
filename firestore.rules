rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'alemarra89@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function validRecord(d, id) {
      return (d.kind == 'favorite'
          && d.keys().hasOnly(['kind','questionId','active'])
          && d.questionId is string && id == 'favorite_' + d.questionId
          && d.active is bool)
        || (d.kind == 'control' && id == 'control'
          && d.keys().hasOnly(['kind','activeSessionId'])
          && (d.activeSessionId == null || (d.activeSessionId is string && d.activeSessionId.size() <= 100)))
        || (d.kind == 'attempt'
          && d.keys().hasOnly(['kind','payload','finishedAt'])
          && id.matches('attempt_[A-Za-z0-9-]+')
          && d.payload is string && d.payload.size() <= 700000
          && d.finishedAt is number)
        || (d.kind == 'session'
          && d.keys().hasOnly(['kind','payload','answers','position','phase'])
          && id.matches('session_[A-Za-z0-9-]+')
          && d.payload is string && d.payload.size() <= 700000
          && d.answers is map && d.answers.size() <= 30
          && d.position is int && d.position >= 0 && d.position < 30
          && d.phase in ['active','completed','abandoned']);
    }
    match /users/{uid}/records/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRecord(request.resource.data,id);
      allow update: if owner(uid) && validRecord(request.resource.data,id)
        && request.resource.data.kind == resource.data.kind
        && (resource.data.kind == 'attempt' ? request.resource.data == resource.data : true)
        && (resource.data.kind == 'session' && resource.data.phase != 'active'
          ? request.resource.data == resource.data : true);
      allow delete: if false;
    }
  }
}
